# Base URL of the multiplayer table server (table-server/, a Cloudflare Worker).
# Local: `cd table-server && npm run dev` serves it on http://localhost:8787 (the default when unset).
# Deploy: the workers.dev URL from `wrangler deploy`, e.g. https://gashis-poker-tables.<you>.workers.dev
NEXT_PUBLIC_TABLE_SERVER_URL=http://localhost:8787
